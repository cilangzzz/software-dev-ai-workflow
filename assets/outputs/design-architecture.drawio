    </mxCell>
    <mxCell id="adr2Content" value="决策: 初期单体架构，预留微服务拆分接口&#xa;理由: 团队规模小，3个月上线MVP&#xa;风险: 需要预留拆分接口，避免后期重构成本" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;whiteSpace=wrap;rounded=0;fontSize=9;" vertex="1" parent="adrHeader">
