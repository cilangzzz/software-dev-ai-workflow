    <mxCell id="adr1Title" value="ADR-001: 选择PostgreSQL作为主数据库" style="text;html=1;strokeColor=none;fillColor=#efebe9;align=left;verticalAlign=middle;spacingLeft=10;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=1;fontColor=#5d4037;" vertex="1" parent="adrHeader">
      <mxGeometry y="40" width="380" height="25" as="geometry"/>
    </mxCell>
    <mxCell id="adr1Content" value="决策: 选择PostgreSQL&#xa;理由: JSONB性能优秀，内置全文搜索&#xa;影响: 商品属性存储更灵活，可暂时不引入ES" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;whiteSpace=wrap;rounded=0;fontSize=9;" vertex="1" parent="adrHeader">
      <mxGeometry y="65" width="380" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="adr2Title" value="ADR-002: 采用单体优先策略" style="text;html=1;strokeColor=none;fillColor=#efebe9;align=left;verticalAlign=middle;spacingLeft=10;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=1;fontColor=#5d4037;" vertex="1" parent="adrHeader">
