    <!-- Code Header -->
    <mxCell id="codeHeader" value="💻 代码实现 - UserService.java" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=35;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#263238;strokeColor=#37474f;fontColor=#80cbc4;fontSize=14;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="20" y="20" width="420" height="380" as="geometry"/>
    </mxCell>

    <mxCell id="codeContent" value="package com.example.service;&#xa;&#xa;import org.springframework.stereotype.Service;&#xa;import org.springframework.beans.factory.annotation.Autowired;&#xa;&#xa;@Service&#xa;public class UserService {&#xa;    &#xa;    @Autowired&#xa;    private UserRepository userRepo;&#xa;    &#xa;    @Autowired&#xa;    private MemberService memberService;&#xa;&#xa;    /**&#xa;     * 用户注册&#xa;     * @param req 注册请求&#xa;     * @return 用户信息&#xa;     */&#xa;    public User register(RegisterRequest req) {&#xa;        // 验证用户是否存在&#xa;        if (userRepo.existsByPhone(req.getPhone())) {&#xa;            throw new BusinessException(&quot;手机号已注册&quot;);&#xa;        }&#xa;        &#xa;        // 创建用户&#xa;        User user = new User();&#xa;        user.setPhone(req.getPhone());&#xa;        user.setPassword(encode(req.getPassword()));&#xa;        user.setMemberLevel(MemberLevel.NORMAL);&#xa;        &#xa;        user = userRepo.save(user);&#xa;        &#xa;        // 发送欢迎消息&#xa;        messageService.sendWelcome(user.getId());&#xa;        &#xa;        return user;&#xa;    }&#xa;}" style="text;strokeColor=none;fillColor=#263238;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;whiteSpace=wrap;rounded=0;fontSize=9;fontFamily=Courier New;fontColor=#a7dbd8;html=1;" vertex="1" parent="codeHeader">
      <mxGeometry y="35" width="420" height="345" as="geometry"/>
    </mxCell>

