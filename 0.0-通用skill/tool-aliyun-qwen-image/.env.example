# 阿里云百炼 Qwen-Image API 配置
# 请将此文件复制为 .env 并填入实际值

# API Key - 从阿里云百炼控制台获取
# 获取地址: https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=your_api_key_here

# API 端点 - 北京地域
DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/api/v1

# API 端点 - 新加坡地域（可选）
# DASHSCOPE_API_URL_INTL=https://dashscope-intl.aliyuncs.com/api/v1

# 同步接口地址
SYNC_ENDPOINT=/services/aigc/multimodal-generation/generation

# 异步接口地址
ASYNC_CREATE_ENDPOINT=/services/aigc/text2image/image-synthesis
ASYNC_QUERY_ENDPOINT=/tasks

# 默认模型
DEFAULT_MODEL=qwen-image-2.0-pro

# 默认分辨率
DEFAULT_SIZE=2048*2048